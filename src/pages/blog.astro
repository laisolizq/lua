---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import "../styles/blog.css";


const posts = await getCollection("posts");


// Posts en inglés
const englishPosts = posts.filter(
    post => post.data.language === "en"
);


// Posts en español sin traducción inglesa
const fallbackPosts = posts.filter(
    post =>
        post.data.language === "es" &&
        !posts.some(
            translated =>
                translated.data.translation === post.id.replace(".md", "")
        )
);


// Unimos y ordenamos por fecha
const displayedPosts = [
    ...englishPosts,
    ...fallbackPosts
].sort(
    (a, b) =>
        b.data.pubDate.valueOf()
        -
        a.data.pubDate.valueOf()
);

---

<BaseLayout>

<section class="section">

<div class="container">


<div class="blog-header">

<p class="subtitle">
Posts about my interests
</p>


<h1>
<span class="accent">
Blog
</span>
</h1>

</div>



<div class="timeline">

{
    displayedPosts.map(post => (

        <a
            class="timeline-item card"
            href={`/lua/blog/${post.id.replace(".md","")}`}
        >

            <h3>
                {post.data.title}
            </h3>


            <p class="date">
                {
                    post.data.pubDate.toLocaleDateString(
                        "en-GB"
                    )
                }
            </p>


            <p>
                {post.data.description}
            </p>

        </a>

    ))
}

</div>


</div>

</section>


</BaseLayout>