---
import BaseLayout from '../../layouts/BaseLayout.astro';
import "../../styles/cv.css";
---

<BaseLayout>
    <html lang="es">
        <head>
            <title>Blog</title>
        </head>

        <body>
            <section class="section">
                <div class="container">
                    <div class="cv-header">
                        <div>
                            <p class="subtitle">
                            Posts sobre mis intereses
                            </p>
                            <h1>
                              <span class="accent">Blog</span>
                            </h1>
                        </div>
                    </div>
                    <div class="timeline">
                        <div class="timeline-item card">
                            <h3>
                                Post 1
                            </h3>
                            <p class="company">
                            Prueba 1
                            </p>
                            <p class="date">
                            01/08/2026
                            </p>
                            <p>
                            Descripción del post 1.
                            </p>
                        </div>
                        <div class="timeline-item card">
                            <h3>
                                Post 2
                            </h3>
                            <p class="company">
                            Prueba 2
                            </p>
                            <p class="date">
                            02/08/2026
                            </p>
                            <p>
                            Descripción del post 2.
                            </p>
                        </div>
                    </div>
                </div>
            </section>
        </body>
    </html>
</BaseLayout>