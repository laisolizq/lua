---
import { getLanguage, getTranslations } from "../i18n/utils";

const lang = getLanguage(Astro.url.pathname);
const t = getTranslations(lang);

const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");

let path = Astro.url.pathname;

if (BASE && BASE !== "/" && path.startsWith(BASE)) {
  path = path.slice(BASE.length);
}

if (path === "") path = "/";

const page = lang === "es"
  ? path.replace(/^\/es/, "") || "/"
  : path;

function url(p: string) {
  return `${BASE}${p}`;
}

const links = [
  {
    href: url(lang === "es" ? "/es/" : "/"),
    label: t.nav.home,
  },
  {
    href: url(lang === "es" ? "/es/blog" : "/blog"),
    label: t.nav.blog,
  },
  {
    href: url(lang === "es" ? "/es/cv" : "/cv"),
    label: t.nav.cv,
  },
];

const languageSwitch = url(
  lang === "es"
    ? page
    : `/es${page === "/" ? "/" : page}`
);

const current = Astro.url.pathname.replace(/\/$/, "");
---

<header class="navbar">

  <div class="container navbar-content">

    <a href={links[0].href} class="logo">
      <img
        src={url("/logo.png")}
        alt="Logo"
        width="30"
        height="30"
      />
    </a>

    <nav>

      <ul class="nav-links">

        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class={
                  current === link.href.replace(/\/$/, "")
                    ? "active"
                    : ""
                }
              >
                {link.label}
              </a>
            </li>
          ))
        }

      </ul>

    </nav>

    <a
      href={languageSwitch}
      class="language-button"
    >
      {lang === "es" ? "EN" : "ES"}
    </a>

  </div>

</header>