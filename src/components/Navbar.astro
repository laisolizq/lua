---
const currentPath = Astro.url.pathname;
import {
    getLanguage,
    getTranslations
} from "../i18n/utils";

const lang = getLanguage(Astro.url.pathname);
const t = getTranslations(lang);
const prefix = lang === "es" ? "/es" : "";
const links = [
  {
      href: `${prefix}/`,
      label: t.nav.home
  },

  {
      href: `${prefix}/blog`,
      label: t.nav.blog
  },

  {
      href: `${prefix}/cv`,
      label: t.nav.cv
  }
];
const languageSwitch =
    lang === "es"
    ? Astro.url.pathname.replace("/es","") || "/"
    : "/es" + Astro.url.pathname;

---

<header class="navbar">
  <div class="container navbar-content">
    <a href={`${prefix}/`} class="logo">
      <img src="/logo.png" width=30px />
    </a>
    <nav>
      <ul class="nav-links">
        {
          links.map(link => (
            <li>
              <a
                href={link.href}
                class={currentPath === link.href ? "active" : ""}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a href={languageSwitch} class="language-button">
      {
          lang === "es"
          ? "EN"
          : "ES"
      }
    </a>
</div>

</header>