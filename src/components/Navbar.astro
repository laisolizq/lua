---
const currentPath = Astro.url.pathname;

const links = [
  { href: "/lua", label: "Inicio" },
  { href: "/lua/blog", label: "Blog" },
  { href: "/lua/cv", label: "CV" },
];
---

<header class="navbar">
  <div class="container navbar-content">

    <a href="/lua" class="logo">
      <img src="../src/assets/logo.png" width=30px/>
      <span>Laia</span>
    </a>

    <nav>
      <ul class="nav-links">
        {
          links.map(link => (
            <li>
              <a
                href={link.href}
                class={currentPath === link.href ? "active" : ""}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

  </div>
</header>